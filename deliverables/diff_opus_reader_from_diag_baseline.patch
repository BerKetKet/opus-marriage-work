+
+        val theme = PageTheme(textColor = Color.BLACK, backgroundColor = Color.WHITE)
+
+        // 1. exam3_normal (geometry index 3: 45px / 68 pitch)
+        val engineNormal = NativeReaderEngine(bridge = JniNativeBridge, assets = assets)
+        try {
+            engineNormal.open(
+                BookSource(id = "exam3_normal", filePath = epubFile.absolutePath),
+                ReaderSettings(kindleGeometryIndex = 3)
+            )
+            val normalIndices = listOf(0, 1, 2, 10, 20, 30, 40, 50, engineNormal.totalPages - 1)
+            for (pIdx in normalIndices) {
+                val page = engineNormal.pageByIndex(pIdx) ?: continue
+                val bmp = Bitmap.createBitmap(1080, 2340, Bitmap.Config.ARGB_8888)
+                val canvas = Canvas(bmp)
+                engineNormal.draw(page, canvas, theme)
+                val outFile = File(outDir, "engine_normal_page_%03d.png".format(pIdx))
+                outFile.outputStream().use { out ->
+                    bmp.compress(Bitmap.CompressFormat.PNG, 100, out)
+                }
+                bmp.recycle()
+                android.util.Log.i("PARITY_DUMP", "Saved normal page $pIdx to ${outFile.absolutePath}")
+            }
+        } finally {
+            engineNormal.close()
+        }
+
+        // 2. exam3_small (geometry index 0: 34px / 51 pitch)
+        val engineSmall = NativeReaderEngine(bridge = JniNativeBridge, assets = assets)
+        try {
+            engineSmall.open(
