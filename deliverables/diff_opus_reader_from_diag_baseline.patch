+            Row(
+                modifier = Modifier
+                    .fillMaxWidth()
+                    .padding(bottom = OpusDimensions.SpacingMedium),
+                horizontalArrangement = Arrangement.SpaceBetween,
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                Row(horizontalArrangement = Arrangement.spacedBy(OpusDimensions.SpacingStandard)) {
+                    Text(
+                        text = "Font",
+                        color = if (activeTab == DisplaySettingsTab.FONT) OpusColors.TextPrimaryDark else OpusColors.TextSecondaryDark,
+                        style = OpusTypography.titleMedium,
+                        fontWeight = if (activeTab == DisplaySettingsTab.FONT) FontWeight.Bold else FontWeight.Normal,
+                        modifier = Modifier
+                            .clickable { activeTab = DisplaySettingsTab.FONT }
+                            .testTag("settings_tab_font")
+                    )
+                    Text(
+                        text = "Themes & Color",
+                        color = if (activeTab == DisplaySettingsTab.THEMES) OpusColors.TextPrimaryDark else OpusColors.TextSecondaryDark,
+                        style = OpusTypography.titleMedium,
+                        fontWeight = if (activeTab == DisplaySettingsTab.THEMES) FontWeight.Bold else FontWeight.Normal,
+                        modifier = Modifier
+                            .clickable { activeTab = DisplaySettingsTab.THEMES }
+                            .testTag("settings_tab_themes")
+                    )
+                }
+                IconButton(
+                    onClick = onDismiss,
+                    modifier = Modifier.testTag("settings_close_button")
+                ) {
+                    Icon(
+                        imageVector = Icons.Default.Close,
+                        contentDescription = "Close",
+                        tint = OpusColors.TextSecondaryDark
+                    )
+                }
+            }
+
+            HorizontalDivider(color = OpusColors.DividerDark)
+            Spacer(modifier = Modifier.height(OpusDimensions.SpacingMedium))
+
+            when (activeTab) {
+                DisplaySettingsTab.FONT -> {
+                    // Font Family row
+                    Row(
+                        modifier = Modifier.fillMaxWidth(),
+                        horizontalArrangement = Arrangement.SpaceBetween,
+                        verticalAlignment = Alignment.CenterVertically
+                    ) {
+                        Text(
+                            text = "Font Family",
+                            color = OpusColors.TextSecondaryDark,
+                            style = OpusTypography.bodyMedium
+                        )
+                        Text(
+                            text = "Bookerly (Calibrated)",
+                            color = OpusColors.TextPrimaryDark,
+                            style = OpusTypography.bodyMedium,
+                            fontWeight = FontWeight.Medium
+                        )
+                    }
+
+                    Spacer(modifier = Modifier.height(OpusDimensions.SpacingLarge))
+
+                    // Font Size Step selector (Small 34px, Normal 42px, Large 45px)
+                    Text(
+                        text = "Size & Spacing (Calibrated Presets)",
+                        color = OpusColors.TextSecondaryDark,
+                        style = OpusTypography.labelMedium
+                    )
+                    Spacer(modifier = Modifier.height(OpusDimensions.SpacingSmall))
+
+                    Row(
+                        modifier = Modifier.fillMaxWidth(),
+                        horizontalArrangement = Arrangement.spacedBy(OpusDimensions.SpacingSmall)
+                    ) {
+                        val presets = listOf(
+                            Triple(0, "Small", "34 px"),
+                            Triple(1, "Normal", "42 px"),
+                            Triple(3, "Large", "45 px")
+                        )
+                        for ((idx, label, sub) in presets) {
+                            val isSelected = currentGeometryIndex == idx
+                            Surface(
+                                color = if (isSelected) OpusColors.AccentBlue else OpusColors.SurfaceDark,
+                                shape = RoundedCornerShape(OpusDimensions.CornerRadiusSmall),
+                                modifier = Modifier
+                                    .weight(1f)
+                                    .height(OpusDimensions.DisplaySettingsPresetHeight)
+                                    .clickable { onSelectGeometryIndex(idx) }
+                                    .testTag("font_size_preset_$idx")
+                            ) {
+                                Column(
+                                    modifier = Modifier.fillMaxSize(),
+                                    horizontalAlignment = Alignment.CenterHorizontally,
+                                    verticalArrangement = Arrangement.Center
+                                ) {
+                                    Text(
+                                        text = label,
+                                        color = if (isSelected) Color.White else OpusColors.TextPrimaryDark,
+                                        style = OpusTypography.bodyMedium,
+                                        fontWeight = if (isSelected) FontWeight.Bold else FontWeight.Normal
+                                    )
+                                    Text(
+                                        text = sub,
+                                        color = if (isSelected) Color.White.copy(alpha = 0.8f) else OpusColors.TextSecondaryDark,
+                                        style = OpusTypography.labelSmall
+                                    )
+                                }
+                            }
+                        }
+                    }
+                }
+                DisplaySettingsTab.THEMES -> {
+                    Text(
+                        text = "Page Color Theme",
+                        color = OpusColors.TextSecondaryDark,
+                        style = OpusTypography.labelMedium
+                    )
+                    Spacer(modifier = Modifier.height(OpusDimensions.SpacingMedium))
+
+                    Row(
+                        modifier = Modifier.fillMaxWidth(),
+                        horizontalArrangement = Arrangement.SpaceEvenly
+                    ) {
+                        val themes = listOf(
+                            Pair(0, "White" to OpusColors.PageWhite),
+                            Pair(1, "Sepia" to OpusColors.PageSepia),
+                            Pair(2, "Green" to OpusColors.PageGreen),
+                            Pair(3, "Black" to OpusColors.PageBlack)
+                        )
+                        for ((idx, info) in themes) {
+                            val (name, color) = info
+                            val isSelected = currentThemeIndex == idx
+                            Column(
+                                horizontalAlignment = Alignment.CenterHorizontally,
+                                modifier = Modifier
+                                    .clickable { onSelectThemeIndex(idx) }
+                                    .testTag("theme_swatch_$idx")
+                            ) {
+                                Box(
+                                    modifier = Modifier
+                                        .size(OpusDimensions.DisplaySettingsSwatchSize)
+                                        .clip(CircleShape)
+                                        .background(color)
+                                        .border(
+                                            width = if (isSelected) OpusDimensions.BorderThicknessSelected else OpusDimensions.DividerThickness,
+                                            color = if (isSelected) OpusColors.AccentBlue else OpusColors.BorderDark,
+                                            shape = CircleShape
+                                        )
+                                )
+                                Spacer(modifier = Modifier.height(OpusDimensions.SpacingXSmall))
+                                Text(
+                                    text = name,
+                                    color = if (isSelected) OpusColors.TextPrimaryDark else OpusColors.TextSecondaryDark,
+                                    style = OpusTypography.labelSmall,
+                                    fontWeight = if (isSelected) FontWeight.Bold else FontWeight.Normal
+                                )
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
