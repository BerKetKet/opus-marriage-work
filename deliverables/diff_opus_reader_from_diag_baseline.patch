diff --git a/engine/src/main/java/app/opusreader/engine/PageBitmapLruCache.kt b/engine/src/main/java/app/opusreader/engine/PageBitmapLruCache.kt
new file mode 100644
index 0000000..f538b4b
--- /dev/null
+++ b/engine/src/main/java/app/opusreader/engine/PageBitmapLruCache.kt
@@ -0,0 +1,145 @@
+package app.opusreader.engine
+
+import android.graphics.Bitmap
+import androidx.annotation.GuardedBy
+import java.util.ArrayDeque
+import java.util.LinkedHashMap
+
+data class BitmapCacheKey(
+    val sessionId: Long,
+    val pageIndex: Int,
+    val textColor: Int,
+    val backgroundColor: Int
+)
+
+/**
+ * Thread-safe LRU cache bounded by count and byte size.
+ *
+ * Supports an internal reusable pool for recycling evicted objects
+ * without triggering allocation churn.
+ */
+open class BoundedLruCache<K, V : Any>(
+    val maxCount: Int,
+    val maxBytes: Long,
+    val maxPoolSize: Int = 2,
+    private val sizeOf: (V) -> Long = { 1L },
+    private val onRecycle: (V) -> Unit = {}
+) {
+    private val lock = Any()
+
+    @GuardedBy("lock")
+    private var currentBytes: Long = 0L
+
+    @GuardedBy("lock")
+    private val map = object : LinkedHashMap<K, V>(maxCount + 1, 0.75f, true) {
+        override fun removeEldestEntry(eldest: MutableMap.MutableEntry<K, V>?): Boolean {
+            return false // Handled explicitly in trimToSize()
+        }
+    }
+
+    @GuardedBy("lock")
+    private val reusablePool = ArrayDeque<V>(maxPoolSize)
+
+    val size: Int
+        get() = synchronized(lock) { map.size }
+
+    val byteCount: Long
+        get() = synchronized(lock) { currentBytes }
+
+    val poolSize: Int
+        get() = synchronized(lock) { reusablePool.size }
+
+    fun get(key: K): V? = synchronized(lock) {
+        map[key]
+    }
+
+    fun containsKey(key: K): Boolean = synchronized(lock) {
+        map.containsKey(key)
+    }
+
+    fun put(key: K, value: V) {
+        synchronized(lock) {
+            val old = map.put(key, value)
+            if (old != null) {
+                currentBytes -= sizeOf(old)
+                if (old !== value) {
+                    offerReusable(old)
+                }
+            }
+            currentBytes += sizeOf(value)
+            trimToSize()
+        }
+    }
+
+    fun obtainReusable(): V? = synchronized(lock) {
+        if (reusablePool.isNotEmpty()) {
+            reusablePool.removeLast()
+        } else {
+            null
+        }
+    }
+
+    private fun offerReusable(value: V) {
+        if (reusablePool.size < maxPoolSize) {
+            reusablePool.add(value)
+        } else {
+            onRecycle(value)
+        }
+    }
+
+    private fun trimToSize() {
+        while (map.size > maxCount || (currentBytes > maxBytes && map.size > 1)) {
+            val iterator = map.entries.iterator()
+            if (!iterator.hasNext()) break
+            val entry = iterator.next()
+            iterator.remove()
+            val evicted = entry.value
+            currentBytes -= sizeOf(evicted)
+            offerReusable(evicted)
+        }
+    }
+
+    fun clear() {
+        synchronized(lock) {
+            for (value in map.values) {
+                onRecycle(value)
+            }
+            map.clear()
+            currentBytes = 0L
+            while (reusablePool.isNotEmpty()) {
+                onRecycle(reusablePool.removeLast())
+            }
+        }
+    }
+}
+
+/**
+ * PageBitmapLruCache specializing [BoundedLruCache] for Android [Bitmap]s.
+ */
+class PageBitmapLruCache(
+    maxCount: Int = 5,
+    maxBytes: Long = 60L * 1024L * 1024L,
+    maxPoolSize: Int = 3,
+    onRecycle: (Bitmap) -> Unit = { bmp ->
+        try {
+            if (!bmp.isRecycled) {
+                bmp.recycle()
+            }
+        } catch (_: Throwable) {
+        }
+    }
+) : BoundedLruCache<BitmapCacheKey, Bitmap>(
+    maxCount = maxCount,
+    maxBytes = maxBytes,
+    maxPoolSize = maxPoolSize,
+    sizeOf = { bmp ->
+        try {
+            bmp.byteCount.toLong().takeIf { it > 0 } ?: (KindleGeometry.SCREEN_W * KindleGeometry.SCREEN_H * 4L)
+        } catch (_: Throwable) {
+            KindleGeometry.SCREEN_W * KindleGeometry.SCREEN_H * 4L
+        }
+    },
+    onRecycle = onRecycle
+) {
+    fun obtainReusableBitmap(): Bitmap? = obtainReusable()
+}
diff --git a/engine/src/test/java/app/opusreader/engine/PageBitmapLruCacheTest.kt b/engine/src/test/java/app/opusreader/engine/PageBitmapLruCacheTest.kt
new file mode 100644
index 0000000..7f74ae0
--- /dev/null
+++ b/engine/src/test/java/app/opusreader/engine/PageBitmapLruCacheTest.kt
@@ -0,0 +1,175 @@
+package app.opusreader.engine
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PageBitmapLruCacheTest {
+
+    private data class FakeBuffer(val id: Int, val bytes: Long = 100L) {
+        var isRecycled: Boolean = false
+    }
+
+    @Test
+    fun boundRespected_maxCount_doesNotExceedLimit() {
+        val recycled = mutableListOf<FakeBuffer>()
+        val cache = BoundedLruCache<Int, FakeBuffer>(
+            maxCount = 3,
+            maxBytes = 1000L,
+            maxPoolSize = 1,
+            sizeOf = { it.bytes },
+            onRecycle = {
+                it.isRecycled = true
+                recycled.add(it)
+            }
+        )
+
+        cache.put(1, FakeBuffer(1))
+        cache.put(2, FakeBuffer(2))
+        cache.put(3, FakeBuffer(3))
+        assertEquals(3, cache.size)
+
+        // Adding 4th exceeds maxCount=3
+        cache.put(4, FakeBuffer(4))
+        assertEquals(3, cache.size)
+        assertFalse(cache.containsKey(1)) // Item 1 evicted
+        assertTrue(cache.containsKey(2))
+        assertTrue(cache.containsKey(3))
+        assertTrue(cache.containsKey(4))
+    }
+
+    @Test
+    fun evictionOrder_leastRecentlyUsedEvictedFirst() {
+        val cache = BoundedLruCache<String, FakeBuffer>(
+            maxCount = 3,
+            maxBytes = 1000L,
+            maxPoolSize = 0,
+            sizeOf = { it.bytes }
+        )
+
+        cache.put("A", FakeBuffer(1))
+        cache.put("B", FakeBuffer(2))
+        cache.put("C", FakeBuffer(3))
+
+        // Access "A" so "B" becomes the least recently used
+        val a = cache.get("A")
+        assertNotNull(a)
+
+        // Put "D" -> "B" should be evicted, not "A"
+        cache.put("D", FakeBuffer(4))
+        assertEquals(3, cache.size)
+        assertTrue(cache.containsKey("A"))
+        assertFalse(cache.containsKey("B"))
+        assertTrue(cache.containsKey("C"))
+        assertTrue(cache.containsKey("D"))
+    }
+
+    @Test
+    fun boundRespected_maxBytes_evictsWhenByteBudgetExceeded() {
+        val cache = BoundedLruCache<Int, FakeBuffer>(
+            maxCount = 10,
+            maxBytes = 250L,
+            maxPoolSize = 0,
+            sizeOf = { it.bytes } // 100 bytes each
+        )
+
+        cache.put(1, FakeBuffer(1, bytes = 100L))
+        cache.put(2, FakeBuffer(2, bytes = 100L))
+        assertEquals(200L, cache.byteCount)
+
+        // Adding 3rd item brings total to 300L > 250L maxBytes
+        cache.put(3, FakeBuffer(3, bytes = 100L))
+        assertEquals(2, cache.size)
+        assertEquals(200L, cache.byteCount)
+        assertFalse(cache.containsKey(1))
+        assertTrue(cache.containsKey(2))
+        assertTrue(cache.containsKey(3))
+    }
+
+    @Test
+    fun reusablePool_receivesEvictedItemsUpToPoolLimit_excessRecycled() {
+        val recycled = mutableListOf<FakeBuffer>()
+        val cache = BoundedLruCache<Int, FakeBuffer>(
+            maxCount = 2,
+            maxBytes = 1000L,
+            maxPoolSize = 2,
+            sizeOf = { it.bytes },
+            onRecycle = {
+                it.isRecycled = true
+                recycled.add(it)
+            }
+        )
+
+        cache.put(1, FakeBuffer(1))
+        cache.put(2, FakeBuffer(2))
+
+        // Evict 1 -> goes to pool
+        cache.put(3, FakeBuffer(3))
+        assertEquals(1, cache.poolSize)
+        assertEquals(0, recycled.size)
+
+        // Evict 2 -> goes to pool (pool size reaches maxPoolSize=2)
+        cache.put(4, FakeBuffer(4))
+        assertEquals(2, cache.poolSize)
+        assertEquals(0, recycled.size)
+
+        // Evict 3 -> pool is full, so item 3 is directly recycled
+        cache.put(5, FakeBuffer(5))
+        assertEquals(2, cache.poolSize)
+        assertEquals(1, recycled.size)
+        assertEquals(3, recycled[0].id)
+        assertTrue(recycled[0].isRecycled)
+
+        // Obtain reusable gives LIFO from pool
+        val reused1 = cache.obtainReusable()
+        assertNotNull(reused1)
+        assertEquals(2, reused1?.id)
+        assertEquals(1, cache.poolSize)
+
+        val reused2 = cache.obtainReusable()
+        assertNotNull(reused2)
+        assertEquals(1, reused2?.id)
+        assertEquals(0, cache.poolSize)
+
+        assertNull(cache.obtainReusable())
+    }
+
+    @Test
+    fun clear_recyclesAllCachedAndPooledItems_leavesZeroLeaks() {
+        val recycled = mutableListOf<FakeBuffer>()
+        val cache = BoundedLruCache<Int, FakeBuffer>(
+            maxCount = 5,
+            maxBytes = 1000L,
+            maxPoolSize = 2,
+            sizeOf = { it.bytes },
+            onRecycle = {
+                it.isRecycled = true
+                recycled.add(it)
+            }
+        )
+
+        cache.put(1, FakeBuffer(1))
+        cache.put(2, FakeBuffer(2))
+        cache.put(3, FakeBuffer(3))
+
+        // Force one into pool
+        cache.put(4, FakeBuffer(4))
+        cache.put(5, FakeBuffer(5))
+        cache.put(6, FakeBuffer(6)) // evicts 1 into pool
+        assertEquals(1, cache.poolSize)
+
+        // Clear everything
+        cache.clear()
+        assertEquals(0, cache.size)
+        assertEquals(0L, cache.byteCount)
+        assertEquals(0, cache.poolSize)
+        assertNull(cache.obtainReusable())
+
+        // All 6 items must be recycled
+        assertEquals(6, recycled.size)
+        assertTrue(recycled.all { it.isRecycled })
+    }
+}
