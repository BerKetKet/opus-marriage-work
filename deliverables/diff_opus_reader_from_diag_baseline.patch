+                outFile.outputStream().use { out ->
+                    bmp.compress(Bitmap.CompressFormat.PNG, 100, out)
+                }
+                bmp.recycle()
+                android.util.Log.i("PARITY_DUMP", "Saved small page $pIdx to ${outFile.absolutePath}")
+            }
+        } finally {
+            engineSmall.close()
+        }
+    }
