+print("=== Gate P3: Text Layer & Page Model Verification (Wire Format v1) ===")
+
+for corp in corpora:
+    cdir = REF_DIR / corp
+    if not cdir.is_dir():
+        print(f"[{corp}] SKIP")
+        continue
+
+    outdir = LOGS_DIR / corp
+    outdir.mkdir(parents=True, exist_ok=True)
+
+    cmd = [KR_CLI, "page-model", str(cdir), "--outdir", str(outdir)]
+    r = subprocess.run(cmd, capture_output=True, text=True, cwd=str(REPO))
+    if r.returncode != 0:
+        print(f"[{corp}] FAIL: kr-cli exit {r.returncode}: {r.stderr.strip()}")
+        continue
+
+    ref_files = sorted(cdir.glob("page_*.model.tsv"))
+    rust_files = sorted(outdir.glob("page_*.model.tsv"))
+
+    corp_ok = 0
+    corp_fail = 0
+
+    for rf in ref_files:
+        total_pages += 1
+        uf = outdir / rf.name
+        if not uf.is_file():
+            corp_fail += 1
+            failed_pages.append((corp, rf.name, "output file missing"))
+            continue
+
+        r_bytes = rf.read_bytes()
+        u_bytes = uf.read_bytes()
+
+        if r_bytes == u_bytes:
+            corp_ok += 1
+            passed_pages += 1
+        else:
+            corp_fail += 1
+            failed_pages.append((corp, rf.name, f"byte mismatch len {len(u_bytes)} vs {len(r_bytes)}"))
+
+    status = "PASS" if corp_fail == 0 else "FAIL"
+    print(f"[{corp}] {status}: {corp_ok}/{len(ref_files)} byte-identical page models ({corp_ok/len(ref_files)*100:.1f}%)")
+
+print()
+print(f"Gate P3 TOTAL: {passed_pages}/{total_pages} ({passed_pages/total_pages*100:.1f}%)")
+if failed_pages:
+    print(f"Total mismatches: {len(failed_pages)}")
+    print(f"First 10 mismatches: {failed_pages[:10]}")
+    sys.exit(1)
+else:
+    print("Gate P3 RESULT: PASS")
+    sys.exit(0)
