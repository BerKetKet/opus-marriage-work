@@ -0,0 +1,96 @@
+#!/usr/bin/env bash
+""":"
+exec python3 "$0" "$@"
+"""
+import sys
+import random
+import subprocess
+import tempfile
+from pathlib import Path
+
+def mutate_bytes(data: bytearray) -> bytearray:
+    buf = bytearray(data)
+    mutations = random.randint(1, 5)
+    for _ in range(mutations):
+        op = random.choice(["flip_bit", "zero_byte", "truncate", "insert_junk", "delete_range"])
+        if op == "flip_bit" and len(buf) > 0:
+            idx = random.randint(0, len(buf) - 1)
+            buf[idx] ^= (1 << random.randint(0, 7))
+        elif op == "zero_byte" and len(buf) > 0:
+            idx = random.randint(0, len(buf) - 1)
+            buf[idx] = 0
+        elif op == "truncate" and len(buf) > 10:
+            cut = random.randint(10, len(buf) - 1)
+            buf = buf[:cut]
+        elif op == "insert_junk" and len(buf) > 0:
+            idx = random.randint(0, len(buf))
+            junk = bytes([random.randint(0, 255) for _ in range(random.randint(1, 64))])
+            buf[idx:idx] = junk
+        elif op == "delete_range" and len(buf) > 32:
+            start = random.randint(0, len(buf) - 16)
+            end = start + random.randint(1, 16)
+            del buf[start:end]
+    return buf
+
+def main():
+    kr_cli = Path("/home/bgg/projects/opus_marriage_work/render.engine/rust/target/release/kr-cli")
+    if not kr_cli.exists():
+        # try cargo target dir
+        kr_cli = Path("/tmp/krtarget/release/kr-cli")
+    if not kr_cli.exists():
+        print(f"ERROR: kr-cli not found at {kr_cli}")
+        sys.exit(1)
+
+    seed_epub = Path("/home/bgg/projects/opus_marriage_work/render.engine/corpora/kindle_exam_v1.epub")
+    if not seed_epub.exists():
+        seed_epub = Path("/home/bgg/projects/opus_marriage_work/opus-reader/engine/src/androidTest/assets/epubs/valid_book.epub")
+    
+    print(f"[fuzz_epub] Using seed epub: {seed_epub}")
+    seed_bytes = seed_epub.read_bytes()
+
+    iterations = 500
+    crashes = 0
+    ok_count = 0
+    err_count = 0
+
+    random.seed(42)
+
+    with tempfile.NamedTemporaryFile(suffix=".epub", delete=False) as tmp:
+        tmp_path = Path(tmp.name)
+
+    try:
+        for i in range(1, iterations + 1):
+            mutated = mutate_bytes(seed_bytes)
+            tmp_path.write_bytes(mutated)
+
+            proc = subprocess.run(
+                [str(kr_cli), "fuzz-epub", str(tmp_path)],
+                capture_output=True,
+                text=True,
+                timeout=5
+            )
+
+            if proc.returncode != 0:
+                print(f"[fuzz_epub] CRASH/PANIC at iteration {i}: exit={proc.returncode} stderr={proc.stderr.strip()}")
+                crashes += 1
+                if crashes >= 5:
+                    break
+            else:
+                out = proc.stdout.strip()
+                if "status=ok" in out:
+                    ok_count += 1
+                else:
+                    err_count += 1
+
+            if i % 100 == 0:
+                print(f"[fuzz_epub] Progress: {i}/{iterations} (ok={ok_count}, handled_errors={err_count}, crashes={crashes})")
+
+        print(f"[fuzz_epub] COMPLETED: iterations={iterations} ok={ok_count} handled_errors={err_count} crashes={crashes} status={'PASS' if crashes == 0 else 'FAIL'}")
+        if crashes > 0:
+            sys.exit(1)
+    finally:
+        if tmp_path.exists():
+            tmp_path.unlink()
+
+if __name__ == "__main__":
+    main()
