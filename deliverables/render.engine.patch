@@ -0,0 +1,99 @@
+#!/usr/bin/env python3
+"""Compare Python reference hashes with tools/golden/*.json, classify mismatches,
+and write tools/golden_local/<corpus>.json with local truth.
+"""
+import json
+import pathlib
+import sys
+
+REPO = pathlib.Path(__file__).resolve().parent.parent
+GOLDEN_DIR = REPO / "tools" / "golden"
+LOCAL_DIR = REPO / "tools" / "golden_local"
+LOCAL_DIR.mkdir(parents=True, exist_ok=True)
+
+ref_manifest_path = REPO / "tools" / "reference_samples" / "reference_manifest.json"
+if not ref_manifest_path.exists():
+    print(f"FAIL: {ref_manifest_path} not found. Run export_reference.py first.")
+    sys.exit(1)
+
+ref_data = json.loads(ref_manifest_path.read_text(encoding="utf-8"))
+prof_data = json.loads((REPO / "tools" / "profiles.json").read_text(encoding="utf-8"))
+
+print(f"=== GATE P0: Python Engine Oracle vs tools/golden/*.json ===")
+print(f"Engine version: {ref_data.get('engine_version')}")
+print(f"Env fingerprint: {ref_data.get('environment_fingerprint')}")
+print(f"FreeType version: {ref_data.get('freetype_version')}")
+print(f"HarfBuzz version: {ref_data.get('harfbuzz')}")
+print()
+
+total_golden_pages = 0
+total_pixel_match = 0
+total_layout_match = 0
+
+for cname, cprof in prof_data["corpora"].items():
+    if cname not in ref_data["corpora"]:
+        print(f"[{cname}] NOT RUN: not in exported reference manifest")
+        continue
+
+    ref_corp = ref_data["corpora"][cname]
+    if ref_corp.get("status") == "NOT_RUN":
+        print(f"[{cname}] NOT RUN: {ref_corp.get('reason')}")
+        continue
+
+    golden_path = GOLDEN_DIR / f"{cname}.json"
+    if not golden_path.exists():
+        print(f"[{cname}] NOT RUN: golden file {golden_path} does not exist")
+        continue
+
+    golden = json.loads(golden_path.read_text(encoding="utf-8"))
+
+    ref_pixels = ref_corp["pixel_pages_sha256"]
+    ref_layout = ref_corp["layout_pages_sha256"]
+    gold_pixels = golden.get("pages", {})
+    gold_layout = golden.get("layout_pages", {})
+
+    all_pages = sorted(set(gold_pixels.keys()) | set(ref_pixels.keys()), key=int)
+    pixel_matches = [p for p in all_pages if ref_pixels.get(p) == gold_pixels.get(p)]
+    pixel_diffs = [p for p in all_pages if ref_pixels.get(p) != gold_pixels.get(p)]
+    layout_matches = [p for p in all_pages if ref_layout.get(p) == gold_layout.get(p)]
+    layout_diffs = [p for p in all_pages if ref_layout.get(p) != gold_layout.get(p)]
+
+    total_golden_pages += len(gold_pixels)
+    total_pixel_match += len(pixel_matches)
+    total_layout_match += len(layout_matches)
+
+    status = "PASS" if not pixel_diffs and not layout_diffs else "DRIFT/DIFF"
+    print(f"[{cname}] {status}: pixels {len(pixel_matches)}/{len(gold_pixels)} ({len(pixel_matches)/len(gold_pixels)*100:.1f}%), "
+          f"layout {len(layout_matches)}/{len(gold_layout)} ({len(layout_matches)/len(gold_layout)*100:.1f}%)")
+    if pixel_diffs:
+        # Classify reasons
+        notes = []
+        for p in pixel_diffs:
+            if cname in ("exam3_normal", "exam3_small") and p == "1":
+                notes.append(f"p1 (cover scaling updated in v1.10.2; golden recorded at v1.10.1)")
+            elif cname == "exam1" and p in ("50", "51"):
+                notes.append(f"p{p} (uses CJK/Emoji font; resolved to fallback)")
+            elif cname == "exam2" and p == "42":
+                notes.append(f"p{p} (uses CJK font; resolved to fallback)")
+            else:
+                notes.append(f"p{p}")
+        print(f"    Pixel differences: {', '.join(notes)}")
+
+    if layout_diffs:
+        print(f"    Layout differences: {layout_diffs[:10]}{'...' if len(layout_diffs)>10 else ''}")
+
+    # Write tools/golden_local/<corpus>.json
+    local_golden = {
+        "corpus": cname,
+        "environment_fingerprint": ref_data.get("environment_fingerprint"),
+        "engine_version": ref_data.get("engine_version"),
+        "page_count": ref_corp["page_count"],
+        "pages": ref_pixels,
+        "layout_pages": ref_layout,
+    }
+    local_path = LOCAL_DIR / f"{cname}.json"
+    local_path.write_text(json.dumps(local_golden, indent=2), encoding="utf-8")
+    print(f"    Wrote local golden to {local_path.relative_to(REPO)}")
+    print()
+
+print(f"Gate P0 Total against legacy goldens: pixels {total_pixel_match}/{total_golden_pages}, layout {total_layout_match}/{total_golden_pages}")
