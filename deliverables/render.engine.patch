@@ -0,0 +1,38 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
+WORK_ROOT="$(cd "${REPO_DIR}/.." && pwd)"
+
+# Ensure logs dir exists
+mkdir -p "${REPO_DIR}/logs"
+
+# Run command inside kr-parity container with incremental volumes
+# Named volumes:
+#   kr-target for /tmp/krtarget
+#   kr-cargo for /opt/cargo/registry
+#   kr-ref for /work/ref
+# Mounts:
+#   render.engine as /workspace
+#   opus-reader as /opus-reader
+# CARGO_TARGET_DIR points to /tmp/krtarget
+docker run --rm \
+    -v "${REPO_DIR}:/workspace" \
+    -v "${WORK_ROOT}/opus-reader:/opus-reader" \
+    -v kr-target:/tmp/krtarget \
+    -v kr-cargo:/opt/cargo/registry \
+    -v kr-ref:/work/ref \
+    -e CARGO_TARGET_DIR=/tmp/krtarget \
+    -w /workspace \
+    kr-parity \
+    bash -c '
+        EXIT_CODE=0
+        if [ "$#" -eq 0 ]; then
+            cargo build --manifest-path rust/Cargo.toml --release
+        else
+            "$@"
+        fi || EXIT_CODE=$?
+        chown -R 1000:1000 /workspace/rust /workspace/logs /opus-reader/engine/src/test/resources 2>/dev/null || true
+        exit $EXIT_CODE
+    ' bash "$@"
