+#!/usr/bin/env python3
+"""Gate P1: IR Round-trip Verification Suite.
+Verifies that kr-cli ir-roundtrip reproduces byte-identical canonical JSON and
+identical layout_sha256 for 100% of exported Python reference page IR files.
+"""
+import hashlib
+import json
+import pathlib
+import subprocess
+import sys
+
+REPO = pathlib.Path(__file__).resolve().parent.parent
+REF_DIR = pathlib.Path("/work/ref")
+if not REF_DIR.exists():
+    REF_DIR = REPO / "ref"
+
+KR_CLI = "/tmp/krtarget/release/kr-cli"
+
+corpora = ["exam1", "exam2", "exam3_normal", "exam3_small", "tables_images"]
+
+total_pages = 0
+passed_pages = 0
+failed_pages = []
+
+print("=== Gate P1: IR Round-Trip Verification ===")
+
+for corp in corpora:
+    cdir = REF_DIR / corp
+    if not cdir.is_dir():
+        print(f"[{corp}] SKIP: {cdir} not found")
+        continue
+
+    pages = sorted(cdir.glob("page_*.ir.json"))
+    corp_ok = 0
+    corp_fail = 0
+
+    for pf in pages:
+        total_pages += 1
+        p_num = str(int(pf.name.split(".")[0].split("_")[1]))
+
+        # Run kr-cli ir-roundtrip --dump
+        cmd = [KR_CLI, "ir-roundtrip", "--dump", str(pf)]
+        r = subprocess.run(cmd, capture_output=True, text=True)
+        if r.returncode != 0:
+            failed_pages.append((corp, p_num, f"kr-cli exit {r.returncode}: {r.stderr.strip()}"))
+            corp_fail += 1
+            continue
+
+        rust_json = r.stdout
+        orig_json = pf.read_text(encoding="utf-8")
+
+        rust_sha = hashlib.sha256(rust_json.encode("utf-8")).hexdigest()
+        orig_sha = hashlib.sha256(orig_json.encode("utf-8")).hexdigest()
+
+        if rust_json == orig_json:
+            corp_ok += 1
+            passed_pages += 1
+        else:
+            failed_pages.append((corp, p_num, f"sha mismatch: rust={rust_sha[:10]} orig={orig_sha[:10]}"))
+            corp_fail += 1
+
+    status = "PASS" if corp_fail == 0 else "FAIL"
+    print(f"[{corp}] {status}: {corp_ok}/{len(pages)} byte-identical canonical JSON pages")
+
+print()
+print(f"Gate P1 TOTAL: {passed_pages}/{total_pages} ({passed_pages/total_pages*100:.1f}%)")
+if failed_pages:
+    print(f"Failed pages (first 10): {failed_pages[:10]}")
+    sys.exit(1)
+else:
+    print("Gate P1 RESULT: PASS")
+    sys.exit(0)
