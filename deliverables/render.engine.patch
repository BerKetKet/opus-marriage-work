new file mode 100755
index 0000000..4b6d916
--- /dev/null
+++ b/rust/build_native_deps.sh
@@ -0,0 +1,91 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+WORK_DIR="${SCRIPT_DIR}/native_deps"
+OUT_DIR="${WORK_DIR}/lib/arm64-v8a"
+NDK_HOME="${ANDROID_NDK_HOME:-/opt/android-ndk}"
+TOOLCHAIN_FILE="${NDK_HOME}/build/cmake/android.toolchain.cmake"
+
+if [ ! -f "${TOOLCHAIN_FILE}" ]; then
+    echo "ERROR: NDK toolchain file not found at ${TOOLCHAIN_FILE}"
+    exit 1
+fi
+
+mkdir -p "${WORK_DIR}/src" "${OUT_DIR}"
+
+FT_VER="2.12.1"
+HB_VER="6.0.0"
+
+FT_TAR="freetype-${FT_VER}.tar.xz"
+HB_TAR="harfbuzz-${HB_VER}.tar.xz"
+
+cd "${WORK_DIR}/src"
+
+# Download FreeType 2.12.1 if not present
+if [ ! -f "${FT_TAR}" ]; then
+    echo "[build_native_deps] Downloading FreeType ${FT_VER}..."
+    curl -L -C - -o "${FT_TAR}" "https://download.savannah.gnu.org/releases/freetype/${FT_TAR}"
+fi
+
+# Download HarfBuzz 6.0.0 if not present
+if [ ! -f "${HB_TAR}" ]; then
+    echo "[build_native_deps] Downloading HarfBuzz ${HB_VER}..."
+    curl -L -C - -o "${HB_TAR}" "https://github.com/harfbuzz/harfbuzz/releases/download/${HB_VER}/${HB_TAR}"
+fi
+
+# Extract
+if [ ! -d "freetype-${FT_VER}" ]; then
+    echo "[build_native_deps] Extracting FreeType..."
+    tar -xf "${FT_TAR}"
+fi
+
+if [ ! -d "harfbuzz-${HB_VER}" ]; then
+    echo "[build_native_deps] Extracting HarfBuzz..."
+    tar -xf "${HB_TAR}"
+fi
+
+# Build static FreeType for arm64-v8a
+echo "[build_native_deps] Building static FreeType ${FT_VER} for arm64-v8a..."
+cmake -S "freetype-${FT_VER}" -B "build-freetype-arm64" -G Ninja \
+    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
+    -DCMAKE_TOOLCHAIN_FILE="${TOOLCHAIN_FILE}" \
+    -DANDROID_ABI=arm64-v8a \
+    -DANDROID_PLATFORM=android-26 \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DBUILD_SHARED_LIBS=OFF \
+    -DFT_DISABLE_ZLIB=ON \
+    -DFT_DISABLE_BZIP2=ON \
+    -DFT_DISABLE_PNG=ON \
+    -DFT_DISABLE_HARFBUZZ=ON \
+    -DFT_DISABLE_BROTLI=ON
+
+ninja -C "build-freetype-arm64"
+cp "build-freetype-arm64/libfreetype.a" "${OUT_DIR}/libfreetype.a"
+
+# Build static HarfBuzz for arm64-v8a
+echo "[build_native_deps] Building static HarfBuzz ${HB_VER} for arm64-v8a..."
+cmake -S "harfbuzz-${HB_VER}" -B "build-harfbuzz-arm64" -G Ninja \
+    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
+    -DCMAKE_TOOLCHAIN_FILE="${TOOLCHAIN_FILE}" \
+    -DANDROID_ABI=arm64-v8a \
+    -DANDROID_PLATFORM=android-26 \
+    -DCMAKE_BUILD_TYPE=Release \
+    -DBUILD_SHARED_LIBS=OFF \
+    -DHB_HAVE_FREETYPE=OFF \
+    -DHB_HAVE_GLIB=OFF \
+    -DHB_HAVE_ICU=OFF \
+    -DHB_BUILD_UTILS=OFF \
+    -DHB_BUILD_SUBSET=OFF
+
+ninja -C "build-harfbuzz-arm64"
+cp "build-harfbuzz-arm64/libharfbuzz.a" "${OUT_DIR}/libharfbuzz.a"
+
+# Copy libc++_static.a and libc++abi.a from NDK sysroot
+echo "[build_native_deps] Copying libc++ static runtime from NDK sysroot..."
+SYSROOT_LIB="${NDK_HOME}/toolchains/llvm/prebuilt/linux-x86_64/sysroot/usr/lib/aarch64-linux-android"
+cp "${SYSROOT_LIB}/libc++_static.a" "${OUT_DIR}/libc++_static.a"
+cp "${SYSROOT_LIB}/libc++abi.a" "${OUT_DIR}/libc++abi.a"
+
+echo "[build_native_deps] Successfully built:"
+ls -lh "${OUT_DIR}/libfreetype.a" "${OUT_DIR}/libharfbuzz.a"
