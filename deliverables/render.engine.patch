+#!/usr/bin/env python3
+"""Gate P2: Rasterizer Verification Suite.
+Feeds Python IR dumps to kr-cli raster and verifies that per-page RGB sha256
+equals the Python pixel sha256 in tools/golden_local/<corpus>.json.
+"""
+import hashlib
+import json
+import os
+import pathlib
+import subprocess
+import sys
+
+REPO = pathlib.Path(__file__).resolve().parent.parent
+REF_DIR = pathlib.Path("/work/ref")
+if not REF_DIR.exists():
+    REF_DIR = REPO / "ref"
+
+GOLDEN_DIR = REPO / "tools" / "golden_local"
+KR_CLI = "/tmp/krtarget/release/kr-cli"
+LOGS_DIR = REPO / "logs" / "gate_p2"
+LOGS_DIR.mkdir(parents=True, exist_ok=True)
+
+corpora = ["exam1", "exam2", "exam3_normal", "exam3_small", "tables_images"]
+
+total_pages = 0
+passed_pages = 0
+failed_pages = []
+
+print("=== Gate P2: Rasterizer Verification (Python IR -> Rust Rasterizer) ===")
+
+for corp in corpora:
+    cdir = REF_DIR / corp
+    gfile = GOLDEN_DIR / f"{corp}.json"
+    if not cdir.is_dir() or not gfile.is_file():
+        print(f"[{corp}] SKIP")
+        continue
+
+    golden = json.loads(gfile.read_text(encoding="utf-8"))
+    gold_pixels = golden.get("pages", {})
+
+    pages = sorted(cdir.glob("page_*.ir.json"))
+    corp_ok = 0
+    corp_fail = 0
+
+    for pf in pages:
+        total_pages += 1
+        p_num = str(int(pf.name.split(".")[0].split("_")[1]))
+        want_sha = gold_pixels.get(p_num)
+
+        cmd = [KR_CLI, "raster", str(pf), "--fonts", "kindle_render/fonts", "--images-dir", str(cdir / "images")]
+        r = subprocess.run(cmd, capture_output=True, text=True, cwd=str(REPO))
+        if r.returncode != 0:
+            failed_pages.append((corp, p_num, f"kr-cli exit {r.returncode}: {r.stderr.strip()}"))
+            corp_fail += 1
+            continue
+
+        got_sha = None
+        for line in r.stdout.splitlines():
+            if line.startswith("page=") and "rgb_sha256=" in line:
+                for f in line.split("\t"):
+                    if f.startswith("rgb_sha256="):
+                        got_sha = f.split("=")[1]
+
+        if got_sha == want_sha:
+            corp_ok += 1
+            passed_pages += 1
+        else:
+            failed_pages.append((corp, p_num, f"got {got_sha} want {want_sha}"))
+            corp_fail += 1
+
+    status = "PASS" if corp_fail == 0 else "FAIL"
+    print(f"[{corp}] {status}: {corp_ok}/{len(pages)} pixel-identical pages ({corp_ok/len(pages)*100:.1f}%)")
+    if corp_fail > 0:
+        fails_in_corp = [p for c, p, _ in failed_pages if c == corp]
+        print(f"    mismatches (first 10): {fails_in_corp[:10]}")
+
+print()
+print(f"Gate P2 TOTAL: {passed_pages}/{total_pages} ({passed_pages/total_pages*100:.1f}%)")
+if failed_pages:
+    print(f"Total mismatches: {len(failed_pages)}")
+    sys.exit(1 if passed_pages < total_pages else 0)
+else:
+    print("Gate P2 RESULT: PASS")
+    sys.exit(0)
