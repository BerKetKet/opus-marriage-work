diff --git a/tools/ir_diff.py b/tools/ir_diff.py
new file mode 100644
index 0000000..a0f5940
--- /dev/null
+++ b/tools/ir_diff.py
@@ -0,0 +1,71 @@
+#!/usr/bin/env python3
+"""Compare two PositionedPage IR JSON files and print the FIRST difference."""
+import argparse
+import json
+import sys
+
+
+def diff_dict(a, b, path=""):
+    keys = sorted(set(a.keys()) | set(b.keys()))
+    for k in keys:
+        p = f"{path}.{k}" if path else k
+        if k not in a:
+            return f"Key '{p}' missing in first, present in second: {b[k]}"
+        if k not in b:
+            return f"Key '{p}' present in first, missing in second: {a[k]}"
+        va, vb = a[k], b[k]
+        if type(va) != type(vb):
+            return f"Type mismatch at '{p}': {type(va).__name__} ({va}) vs {type(vb).__name__} ({vb})"
+        if isinstance(va, dict):
+            res = diff_dict(va, vb, p)
+            if res:
+                return res
+        elif isinstance(va, list):
+            res = diff_list(va, vb, p)
+            if res:
+                return res
+        elif va != vb:
+            return f"Value mismatch at '{p}':\n  first:  {va}\n  second: {vb}"
+    return None
+
+
+def diff_list(a, b, path=""):
+    if len(a) != len(b):
+        return f"List length mismatch at '{path}': {len(a)} vs {len(b)}"
+    for idx, (va, vb) in enumerate(zip(a, b)):
+        p = f"{path}[{idx}]"
+        if type(va) != type(vb):
+            return f"Type mismatch at '{p}': {type(va).__name__} ({va}) vs {type(vb).__name__} ({vb})"
+        if isinstance(va, dict):
+            res = diff_dict(va, vb, p)
+            if res:
+                return res
+        elif isinstance(va, list):
+            res = diff_list(va, vb, p)
+            if res:
+                return res
+        elif va != vb:
+            return f"Value mismatch at '{p}':\n  first:  {va}\n  second: {vb}"
+    return None
+
+
+def main():
+    ap = argparse.ArgumentParser(description="Diff two PositionedPage IR JSON files")
+    ap.add_argument("file_a", help="First IR JSON file")
+    ap.add_argument("file_b", help="Second IR JSON file")
+    args = ap.parse_args()
+
+    a = json.loads(open(args.file_a, encoding="utf-8").read())
+    b = json.loads(open(args.file_b, encoding="utf-8").read())
+
+    diff = diff_dict(a, b)
+    if diff:
+        print(f"DIFF FOUND:\n{diff}")
+        sys.exit(1)
+    else:
+        print("IDENTICAL")
+        sys.exit(0)
+
+
+if __name__ == "__main__":
+    main()
