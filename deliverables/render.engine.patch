+#!/usr/bin/env python3
+"""Dump raw image byte buffers for all unique images in Python IR to /work/ref/<corpus>/images/<sha>.raw."""
+import json
+import os
+import pathlib
+import sys
+
+REPO = pathlib.Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(REPO))
+
+from kindle_render.config import Config
+from kindle_render.epub import load_epub
+from kindle_render.fonts import Family
+from kindle_render.page import layout_blocks_to_ir
+from tools.corpus import make_config, resolve_corpus_file
+
+prof_data = json.loads((REPO / "tools" / "profiles.json").read_text(encoding="utf-8"))
+search_paths = prof_data.get("search_paths", ["."])
+
+REF_DIR = pathlib.Path("/work/ref")
+if not REF_DIR.exists():
+    REF_DIR = REPO / "ref"
+
+for cname, cprof in prof_data["corpora"].items():
+    try:
+        epub_path = resolve_corpus_file(cprof["epub"], search_paths)
+    except FileNotFoundError:
+        continue
+
+    img_dir = REF_DIR / cname / "images"
+    img_dir.mkdir(parents=True, exist_ok=True)
+
+    cfg = make_config(cprof["config"])
+
+    blocks = load_epub(str(epub_path), cfg)
+    fam = Family(cfg)
+    ir_doc = layout_blocks_to_ir(blocks, cfg, fam, max_pages=cprof.get("max_pages", 100))
+
+    saved = 0
+    for p in ir_doc.pages:
+        for c in p.commands:
+            if c.kind == "image" and hasattr(c, "pixels") and c.pixels is not None:
+                p_file = img_dir / f"{c.image_sha256}.raw"
+                if not p_file.exists():
+                    p_file.write_bytes(c.pixels.tobytes())
+                    saved += 1
+    print(f"[{cname}] Dumped {saved} images to {img_dir}")
