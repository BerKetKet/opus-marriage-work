+                ReaderSettings(kindleGeometryIndex = 1)
+            )
+            val openMs = (System.nanoTime() - t0) / 1_000_000.0
+
+            val t1 = System.nanoTime()
+            val page0 = engine.pageAt(Locator(0, 0))
+            val modelMs = (System.nanoTime() - t1) / 1_000_000.0
+
+            val renderTimes = mutableListOf<Double>()
+            val bitmap = Bitmap.createBitmap(1080, 2340, Bitmap.Config.ARGB_8888)
+            val canvas = Canvas(bitmap)
+            val theme = PageTheme(textColor = Color.BLACK, backgroundColor = Color.WHITE)
+
+            for (i in 0 until 10) {
+                val tr0 = System.nanoTime()
+                engine.draw(page0, canvas, theme)
+                val trMs = (System.nanoTime() - tr0) / 1_000_000.0
+                renderTimes.add(trMs)
+            }
+            renderTimes.sort()
+            val p50 = renderTimes[(renderTimes.size * 0.50).toInt()]
+            val p95 = renderTimes[(renderTimes.size * 0.95).toInt().coerceAtMost(renderTimes.size - 1)]
+
+            android.util.Log.i("DEVICE_BENCHMARK", String.format(
