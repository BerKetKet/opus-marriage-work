+                        } catch (_: Throwable) {
+                        }
+                    }
+                }
+                return null
+            }
+
+            override fun hyphenationBytes(lang: String): ByteArray? {
+                for (ctx in listOf(testContext, targetContext)) {
+                    for (candidate in listOf("hyphen/hyph_${lang}.bin", "hyphen/hyph_${lang}.dic", "hyph_${lang}.bin", "hyph_${lang}.dic")) {
+                        try {
+                            ctx.assets.open(candidate).use { return it.readBytes() }
+                        } catch (_: Throwable) {
+                        }
+                    }
+                }
+                return null
+            }
+        }
+
+        val engine = NativeReaderEngine(bridge = JniNativeBridge, assets = assets)
